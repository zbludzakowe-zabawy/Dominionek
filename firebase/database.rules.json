{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "$room.length >= 20",
        ".write": "(!data.exists() && $room.length >= 20 && $room.length <= 40) || (data.exists() && !newData.exists() && (((data.child('act').isNumber() && data.child('act').val() < now - 1209600000) || (!data.child('act').exists() && data.child('at').isNumber() && data.child('at').val() < now - 1209600000)) || (data.child('next').exists() && ((data.child('act').isNumber() && data.child('act').val() < now - 172800000) || (!data.child('act').exists() && data.child('at').isNumber() && data.child('at').val() < now - 172800000)))))",
        "cfg": { ".validate": "newData.isString() && newData.val().length < 4000" },
        "at": { ".validate": "newData.isNumber()" },
        "act": {
          ".write": "root.child('rooms').child($room).child('cfg').exists()",
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        },
        "prep": {
          ".write": "root.child('rooms').child($room).child('start').exists()",
          ".validate": "newData.isNumber() && newData.val() <= now + 600000"
        },
        "seats": {
          "$seat": {
            ".write": "!data.exists() && root.child('rooms').child($room).child('cfg').exists() && !root.child('rooms').child($room).child('start').exists()",
            ".validate": "$seat.matches(/^[0-9]$/) && newData.hasChildren(['name', 'cid']) && newData.child('name').isString() && newData.child('name').val().length <= 24 && newData.child('cid').isString() && newData.child('cid').val().length <= 40",
            "name": {
              ".write": "data.exists() && !root.child('rooms').child($room).child('start').exists()",
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
            },
            "cid": { ".validate": true },
            "$other": { ".validate": false }
          }
        },
        "start": {
          ".write": "!data.exists() && root.child('rooms').child($room).child('cfg').exists()",
          ".validate": "newData.isNumber()"
        },
        "moves": {
          "$n": {
            ".write": "!data.exists() && root.child('rooms').child($room).child('start').exists()",
            ".validate": "$n.matches(/^[0-9]{1,5}$/) && newData.isString() && newData.val().length <= 300"
          }
        },
        "next": {
          ".write": "!data.exists() && root.child('rooms').child($room).child('start').exists()",
          ".validate": "newData.isString() && newData.val().length >= 20 && newData.val().length <= 40"
        },
        "ping": {
          "$seat": {
            ".write": "root.child('rooms').child($room).child('cfg').exists()",
            ".validate": "$seat.matches(/^[0-9]$/) && newData.isNumber()"
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
